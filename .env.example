# cp .env.example .env; replace both placeholders before starting
SECRET_KEY=replace-with-random-secret-at-least-50-characters
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=leasefit
POSTGRES_USER=leasefit
POSTGRES_HOST=db
POSTGRES_PORT=5432
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.invalid
SUPPORT_EMAIL=
