# http {} context, e.g. /etc/nginx/conf.d/leasefit.conf
limit_req_zone $binary_remote_addr zone=leasefit_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=leasefit_pilot:10m rate=5r/m;
server {
    listen 80;
    server_name app.example.org;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.example.org;
    ssl_certificate /etc/letsencrypt/live/app.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    # Do not log tokens, resource URLs, contacts or report content.
    access_log off;
    location ~ ^/(login|password-reset|invite/) {
        limit_req zone=leasefit_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
    location = /pilot {
        limit_req zone=leasefit_pilot burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
}
